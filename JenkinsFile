pipeline {
    agent any

    stages {

        stage('Git hub clone rep') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Natali-rg/Turchyna_Hillel_07_05.git'
            }
        }
        stage('Check Docker') {
            steps {
                sh '''
                    docker --version
                    docker compose version
                    docker info
                '''
            }
        }

        stage('Run Docker Compose') {
            steps {
                sh '''
                    cd Lessons/homework29

                    docker compose down --remove-orphans || true
                    docker compose up -d --build
                '''
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    cd Lessons/homework29

                    rm -rf allure-results/*
                    rm -rf test-results/*
                    mkdir -p test-results

                    docker compose run --name homework29_test app pytest \
                        --junitxml=/app/test-results/test-results.xml \
                        --alluredir=/app/allure-results

                    docker cp homework29_test:/app/test-results/test-results.xml ./test-results/test-results.xml

                    docker rm homework29_test
                '''
            }
        }

        stage('Publish test results') {
            steps {
                sh '''
                    ls -la Lessons/homework29/test-results
                '''

                junit 'Lessons/homework29/test-results/test-results.xml'
            }
        }

        stage('Publish Allure Report') {
            steps {
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'Lessons/homework29/allure-results']]
                ])
            }
        }
    }

    post {
        always {
            sh '''
                cd Lessons/homework29
                docker compose down --remove-orphans || true
            '''
        }

        success {
            echo 'All tests passed!'
        }

        failure {
            echo 'Some tests failed!'
        }
    }
}