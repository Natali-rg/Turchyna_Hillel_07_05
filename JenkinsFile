pipeline {
    agent any

    stages {

        stage('Git hub clone rep') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Natali-rg/Turchyna_Hillel_07_05.git'
            }
        }

        stage('Run Docker Compose') {
            steps {
                sh '''
                    cd Lessons/homework29

                    docker compose down --remove-orphans || true
                    docker compose up -d --build
                '''
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    cd Lessons/homework29

                    docker compose run --rm app
                '''
            }
        }

        stage('Publish test results') {
            steps {
                junit 'Lessons/homework29/test-results.xml'
            }
        }

        stage('Publish Allure Report') {
            steps {
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'Lessons/homework29/allure-results']]
                ])
            }
        }
    }

    post {
        always {
            sh '''
                cd Lessons/homework29
                docker compose down --remove-orphans || true
            '''
        }

        success {
            echo 'All tests passed!'
        }

        failure {
            echo 'Some tests failed!'
        }
    }
}